solido = false
lineas_primera_visita = PackedStringArray("Alto... ah, eres tú. Soy Bruno. Hago la ronda alrededor de la plaza.", "Si ves algo raro, avísame. Aunque aquí lo más raro es el gato del molinero.")
lineas_habituales = PackedStringArray("Sin novedad en la aldea. Sigo con la ronda.")
puntos = PackedVector3Array(12.8, 0, -10.8, 12.8, 0, 12.8, -12.8, 0, 12.8, -12.8, 0, -10.8)

