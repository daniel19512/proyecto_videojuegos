[node name="Herrero" parent="NPCs" instance=ExtResource("8_aldeano")]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, -18, 0, -2)
id_npc = &"herrero"
nombre = "Gonzalo, el herrero"
frames = ExtResource("12_f_herrero")
tamano_pixel = 0.0323
desplazamiento = Vector2(0, 26.79)
mirada = Vector3(-1, 0, 0)
lineas_primera_visita = PackedStringArray("¿Eh? Perdona, con el martillo no te oía. Soy Gonzalo.", "Herraduras, bisagras, clavos... si es de hierro, sale de esta forja.", "Dicen que Marta, la panadera, anda buscando quien le haga un recado.")
lineas_habituales = PackedStringArray("El yunque no descansa. Vuelve cuando necesites algo de hierro.")

[node name="Tabernero" parent="NPCs" instance=ExtResource("8_aldeano")]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, -12, 0, -15.2)
id_npc = &"tabernero"
nombre = "Anselmo, el tabernero"
frames = ExtResource("14_f_tabernero")
tamano_pixel = 0.0323
desplazamiento = Vector2(0, 26.79)
lineas_primera_visita = PackedStringArray("¡Bienvenido a la taberna! Soy Anselmo. Salgo a tomar el aire entre jarra y jarra.", "Dentro hay guiso caliente y sitio de sobra. La puerta está aquí al lado.", "Aquí se entera uno de todo: si buscas trabajo, pregunta a Marta, la panadera.")
lineas_habituales = PackedStringArray("Pasa, pasa. La cerveza no se sirve sola.")

[node name="Guardia" parent="NPCs" instance=ExtResource("8_aldeano")]
