static func has_icon(icon_name: String) -> bool:
	return ICONS.has(icon_name)

static func get_icon(icon_name: String) -> AtlasTexture:
	var p: Vector2i = ICONS[icon_name]
	var t := AtlasTexture.new()
	t.atlas = SHEET
	t.region = Rect2(p.x, p.y, SIZE, SIZE)
	return t
