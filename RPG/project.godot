; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="SapientIA"
run/main_scene="res://scenes/presentacion/menu_principal.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://assets/branding/sapientIA.png"
config/windows_native_icon="res://assets/branding/sapientIA.ico"

[autoload]

Ajustes="*res://scripts/presentacion/ajustes.gd"
Partidas="*res://scripts/presentacion/partidas.gd"
GestorRegiones="*res://scripts/gestor_regiones.gd"
IA="*res://scripts/ia/servicio_ia.gd"
Historia="*res://scripts/ia/historia.gd"
Reloj="*res://scripts/ia/reloj.gd"
Aldeanos="*res://scripts/ia/aldeanos.gd"
DialogoIA="*res://scripts/ia/dialogo_ia.gd"
Diario="*res://scripts/ia/diario.gd"
MenuPausa="*res://scripts/ia/menu_pausa.gd"
EstadoMundo="*res://scripts/vida/estado_mundo.gd"
InterfazVida="*res://scripts/vida/interfaz_vida.gd"
Misiones="*res://scripts/vida/misiones.gd"
MapaMundo="*res://scripts/presentacion/mapa_mundo.gd"
HUD="*res://scripts/presentacion/hud.gd"
AudioJuego="*res://scripts/presentacion/audio_juego.gd"

[display]

window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[filesystem]

import/blender/enabled=false

[gui]

theme/custom="res://scenes/presentacion/sapientia.tres"

